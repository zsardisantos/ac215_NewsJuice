FROM python:3.12-slim

WORKDIR /app

# Install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# Copy project files
COPY pyproject.toml .
# Copy only necessary python files to avoid cache busting on random changes, but actually we need most of them
COPY *.py ./
COPY tests/ ./tests/

# Install dependencies including dev
RUN uv sync --all-extras

CMD ["uv", "run", "pytest", "-v"]
