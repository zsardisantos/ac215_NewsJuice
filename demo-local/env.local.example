# Copy to services/chatter_deployed/.env  (that path is already gitignored-adjacent --
# double-check before committing) and fill in the two GCP values.

# --- Local Postgres (from demo-local/docker-compose.yml) -----------------
DATABASE_URL=postgresql://postgres:newsjuice@localhost:5433/newsdb
DB_URL=postgresql://postgres:newsjuice@localhost:5433/newsdb

# --- Your NEW GCP project ------------------------------------------------
GOOGLE_CLOUD_PROJECT=REPLACE_ME
GOOGLE_CLOUD_REGION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=/Users/zachary-sardi-santos/secrets/newsjuice-demo-sa.json

# --- Server / CORS -------------------------------------------------------
PORT=8080
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# --- Optional ------------------------------------------------------------
# GCS audio upload is only used by the daily-brief path. Leave unset for the
# live voice demo; set both if you want briefs persisted to a bucket.
# AUDIO_BUCKET=
# GCS_PREFIX=podcasts/

# Firebase Admin: only needed if you run WITH auth. If unset, the WebSocket
# handler proceeds unauthenticated (main.py:357) -- which is what the demo uses.
# GEMINI_SERVICE_ACCOUNT_PATH=
